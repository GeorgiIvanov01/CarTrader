<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CarTrader</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarTrader.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark car-navbar">
            <div class="container">
                <a class="navbar-brand car-brand" asp-controller="Vehicle" asp-action="Index"> <i class="fas fa-car-side"></i> Car<span>Trader</span></a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a asp-controller="Vehicle" asp-action="AllVehicles" class="nav-link"> <i class="fas fa-car"> </i> All Vehicles </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a asp-controller="Vehicle" asp-action="Favorites"class="nav-link"> <i class="fas fa-heart"></i> Favorites </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Vehicle" asp-action="Create" class="nav-link"> <i class="fas fa-plus-circle"></i> Sell Vehicle </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Vehicle" asp-action="MyVehicles" class="nav-link"> <i class="fas fa-garage"></i> My Vehicles </a>
                            </li>
                        }

                    </ul>

                    <div class="navbar-account">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="car-footer">
        <div class="container">

            <div class="footer-content">

                <div>
                    <a asp-controller="Vehicle" asp-action="Index" class="footer-brand"> <i class="fas fa-car-side"></i> CarTrader </a>
                    <p>Find your next journey with confidence.</p>
                </div>

                <div class="footer-links">
                    <span>&copy; 2026 CarTrader. All rights reserved.</span>

                    <a asp-area="" asp-controller="Home" asp-action="Privacy"> Privacy  </a>
                </div>

            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>