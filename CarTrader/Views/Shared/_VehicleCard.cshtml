@model AllVehiclesViewModel

<div class="vehicle-card">

    <div class="vehicle-image-wrapper">

        <img src="@Model.ImageUrl"
             class="vehicle-image"
             alt="@Model.Make @Model.Model" />

    </div>

    <div class="vehicle-card-body">

        <h5>@Model.Make @Model.Model (@Model.Year)</h5>

        <div class="vehicle-price"> @Model.Price.ToString("C", new System.Globalization.CultureInfo("en-GB")) </div>

        <div class="vehicle-specs">

            <span>
                <i class="fas fa-road"></i>
                @Model.Mileage km
            </span>

            <span>
                <i class="fas fa-cogs"></i>
                @Model.EngineSize cc
            </span>

        </div>

        <div class="vehicle-card-actions">

            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-details"> <i class="fas fa-eye"></i> Details </a>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Vehicle" asp-action="AddFavorite" method="post" class="vehicle-favorite-form">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit" class="btn btn-favorite"> <i class="fas fa-heart"></i> Favorite </button>
                </form>
            }

        </div>

    </div>

</div>