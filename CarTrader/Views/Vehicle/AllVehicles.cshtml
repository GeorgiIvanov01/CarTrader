@model IEnumerable<AllVehiclesViewModel>

@{
    ViewData["Title"] = "All Vehicles";
}

<div class="page-header">

    <div>
        <span class="section-eyebrow">EXPLORE OUR COLLECTION</span>
        <h1>Find Your Next Vehicle</h1>
        <p>Discover vehicles that match your lifestyle and budget.</p>
    </div>

</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-car-side"></i>
        <h3>No Vehicles Available</h3>
        <p>There are currently no vehicles listed. Please check back later.</p>
    </div>
}
else
{
    <div class="vehicle-grid">

        @foreach (var vehicle in Model)
        {
            <div class="vehicle-card">

                <div class="vehicle-image-wrapper">

                    @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                    {
                        <img src="@vehicle.ImageUrl"
                             class="vehicle-image"
                             alt="@vehicle.Make @vehicle.Model" />
                    }
                    else
                    {
                        <img src="@(Url.Content("~/images/default-image.svg"))"
                             class="vehicle-image"
                             alt="No Image Available" />
                    }

                    <span class="vehicle-category">
                        @vehicle.CategoryName
                    </span>

                </div>

                <div class="vehicle-card-body">

                    <h5>@vehicle.Make @vehicle.Model</h5>

                    <div class="vehicle-price">
                        £@vehicle.Price.ToString("#,##0").Replace(",", ".")
                    </div>

                    <div class="vehicle-card-actions">

                        @if (User?.Identity?.IsAuthenticated == true && !vehicle.IsOwner && !vehicle.IsSaved)
                        {
                            <form asp-controller="Vehicle" asp-action="Save" method="post" class="vehicle-favorite-form">
                                <input type="hidden"
                                       name="id"
                                       value="@vehicle.Id" />

                                <button type="submit"
                                        class="btn btn-favorite">

                                    <i class="fas fa-heart"></i>
                                    Favorites
                                </button>

                            </form>

                            <a asp-controller="Vehicle"  asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-details"> <i class="fas fa-eye"></i> Details </a>
                        }
                        else
                        {
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-details w-100"> <i class="fas fa-eye"></i> View Details </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}