@model IEnumerable<UserVehicleViewModel>

@{
    ViewData["Title"] = "My Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Vehicles</h1>
    <a asp-controller="Vehicle" asp-action="Create" class="btn btn-success">Create New Vehicle</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You have not created any vehicles yet.</div>
}
else
{
    <div class="row">
        @foreach (var v in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <img src="@v.ImageUrl" class="card-img-top" alt="@v.Make @v.Model" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@v.Make @v.Model (@v.Year)</h5>
                        <p class="card-text">@v.Price.ToString("C")</p>
                        <p class="card-text"><small class="text-muted">@v.Mileage km · @v.EngineSize cc</small></p>

                        <div class="mt-auto">
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@v.Id" class="btn btn-primary">Details</a>
                            <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@v.Id" class="btn btn-outline-secondary ms-2">Edit</a>
                            <form asp-controller="Vehicle" asp-action="DeleteConfirmed" method="post" class="d-inline ms-2">
                                <input type="hidden" name="id" value="@v.Id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
