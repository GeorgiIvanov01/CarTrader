@model DetailsViewModel

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Make @Model.Model" />
    </div>
    <div class="col-md-6">
        <h2>@Model.Make @Model.Model (@Model.Year)</h2>
        <h4>@Model.Price.ToString("C")</h4>
        <p>@Model.Description</p>

        <dl class="row">
            <dt class="col-sm-4">Mileage</dt>
            <dd class="col-sm-8">@Model.Mileage</dd>

            <dt class="col-sm-4">Engine Size (cc)</dt>
            <dd class="col-sm-8">@Model.EngineSize</dd>

            <dt class="col-sm-4">Doors</dt>
            <dd class="col-sm-8">@Model.Doors</dd>

            <dt class="col-sm-4">Fuel</dt>
            <dd class="col-sm-8">@Model.FuelType</dd>

            <dt class="col-sm-4">Transmission</dt>
            <dd class="col-sm-8">@Model.TransmissionType</dd>

            <dt class="col-sm-4">Condition</dt>
            <dd class="col-sm-8">@Model.Condition</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Model.CategoryName</dd>
        </dl>

        <div class="mt-3">
            <a asp-controller="Vehicle" asp-action="Index" class="btn btn-secondary">Back</a>
            @if (Model.IsOwner)
            {
                <a asp-controller="Vehicle" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger ms-2">Delete</a>
            }
        </div>
    </div>
</div>
