@model DetailsViewModel

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="page-header">
    <div>
        <span class="section-eyebrow">VEHICLE INFORMATION</span>
        <h1>Vehicle Details</h1>
        <p>Everything you need to know about this vehicle.</p>
    </div>
</div>

<div class="details-container">

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="details-image-wrapper">

                <img src="@Model.ImageUrl"
                     class="details-image"
                     alt="@Model.Make @Model.Model" />

            </div>

        </div>

        <div class="col-lg-6">

            <div class="details-content">

                <span class="section-eyebrow">CARTRADER LISTING</span>

                <h2>@Model.Make @Model.Model</h2>

                <span class="details-year">@Model.Year</span>

              <div class="details-price"> @Model.Price.ToString("C", new System.Globalization.CultureInfo("en-GB")) </div>

                <div class="details-description">
                    <h5>Description</h5>
                    <p>@Model.Description</p>
                </div>

                <div class="specifications-section">

                    <h5>
                        <i class="fas fa-list-ul me-2"></i>
                        Vehicle Specifications
                    </h5>

                    <dl class="specifications-list">

                        <div class="specification-item">
                            <dt>Mileage</dt>
                            <dd>@Model.Mileage</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Engine Size</dt>
                            <dd>@Model.EngineSize cc</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Doors</dt>
                            <dd>@Model.Doors</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Fuel Type</dt>
                            <dd>@Model.FuelType</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Transmission</dt>
                            <dd>@Model.TransmissionType</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Condition</dt>
                            <dd>@Model.Condition</dd>
                        </div>

                        <div class="specification-item">
                            <dt>Category</dt>
                            <dd>@Model.CategoryName</dd>
                        </div>

                    </dl>

                </div>

                <div class="details-actions">

                    <a asp-controller="Vehicle" asp-action="AllVehicles" class="btn btn-outline-secondary"> <i class="fas fa-arrow-left me-2"></i> Back </a>

                    @if (Model.IsOwner)
                    {
                        <a asp-controller="Vehicle" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> <i class="fas fa-trash me-2"></i> Delete Vehicle </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>