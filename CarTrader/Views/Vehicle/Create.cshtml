 *@
@using CarTrader.Data.Enums
@model CreateViewModel

@{
    ViewData["Title"] = "Create Vehicle";
}

<div class="page-header">
    <div>
        <span class="section-eyebrow">SELL YOUR VEHICLE</span>
        <h1>List a New Vehicle</h1>
        <p>Provide your vehicle details to create a listing.</p>
    </div>
</div>

<div class="form-container">

    <form asp-action="Create" method="post">

        <div class="form-section">

            <div class="form-section-heading">
                <i class="fas fa-car"></i>
                <div>
                    <h4>Basic Information</h4>
                    <p>Enter the main details of your vehicle.</p>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Make" class="form-label">Make</label>
                    <input asp-for="Make" class="form-control" placeholder="e.g. BMW" />
                    <span asp-validation-for="Make" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Model" class="form-label">Model</label>
                    <input asp-for="Model" class="form-control" placeholder="e.g. 320d" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Year" class="form-label">Year</label>
                    <input asp-for="Year" class="form-control" placeholder="e.g. 2022" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Price" class="form-label">Price (£)</label>
                    <input asp-for="Price" class="form-control" placeholder="Vehicle price" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Mileage" class="form-label">Mileage (km)</label>
                    <input asp-for="Mileage" class="form-control" placeholder="e.g. 45000" />
                    <span asp-validation-for="Mileage" class="text-danger"></span>
                </div>

            </div>

        </div>

        <div class="form-section">

            <div class="form-section-heading">
                <i class="fas fa-cogs"></i>
                <div>
                    <h4>Technical Specifications</h4>
                    <p>Tell buyers more about the vehicle.</p>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label asp-for="EngineSize" class="form-label">Engine Size (cc)</label>
                    <input asp-for="EngineSize" class="form-control" />
                    <span asp-validation-for="EngineSize" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Doors" class="form-label">Doors</label>
                    <select asp-for="Doors"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<DoorCount>()">
                    </select>
                    <span asp-validation-for="Doors" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="FuelType" class="form-label">Fuel Type</label>
                    <select asp-for="FuelType"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<FuelType>()">
                    </select>
                    <span asp-validation-for="FuelType" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TransmissionType" class="form-label">Transmission</label>
                    <select asp-for="TransmissionType"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<TransmissionType>()">
                    </select>
                    <span asp-validation-for="TransmissionType" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Condition" class="form-label">Condition</label>
                    <select asp-for="Condition"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<VehicleCondition>()">
                    </select>
                    <span asp-validation-for="Condition" class="text-danger"></span>
                </div>

            </div>

        </div>

        <div class="form-section">

            <div class="form-section-heading">
                <i class="fas fa-images"></i>
                <div>
                    <h4>Listing Information</h4>
                    <p>Add an image and categorise your vehicle.</p>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                <input asp-for="ImageUrl"
                       class="form-control"
                       placeholder="https://example.com/vehicle.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">

                <label asp-for="CategoryId" class="form-label">Category</label>

                @if (Model?.Categories != null)
                {
                    <select asp-for="CategoryId"
                            class="form-select"
                            aria-required="true">

                        <option value="">Select a category</option>

                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.CategoryId == c.Id ? "selected" : null)">
                                @c.Name
                            </option>
                        }

                    </select>
                }
                else
                {
                    <select asp-for="CategoryId"
                            class="form-select"
                            aria-required="true"
                            asp-items="ViewBag.CategorySelectList">

                        <option value="">Select a category</option>

                    </select>
                }

                <span asp-validation-for="CategoryId" class="text-danger"></span>

            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Describe your vehicle, its features and condition..."></textarea>

                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent"> <i class="fas fa-plus-circle me-2"></i> Create Listing </button>
            <a asp-controller="Vehicle" asp-action="AllVehicles" class="btn btn-outline-secondary"> Cancel </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}