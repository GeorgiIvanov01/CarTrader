@model IEnumerable<IndexViewModel>

@{
    ViewData["Title"] = "All Vehicles";
    // var categories = ViewBag.Categories as IEnumerable<CategoryViewModel>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>All Vehicles</h1>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div>
            <a asp-controller="Vehicle" asp-action="Favorites" class="btn btn-primary me-2">Favorites</a>
            <a asp-controller="Vehicle" asp-action="Create" class="btn btn-success">Create New Vehicle</a>
        </div>
    }
</div>

<div class="row text-center">
    @foreach (var vehicle in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100" style="width: 100%;">
                @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                {
                    <img src="@vehicle.ImageUrl" class="card-img-top" style="max-height: 150px; object-fit: contain;" alt="@vehicle.Make @vehicle.Model">
                }
                else
                {
                    <img src="@(Url.Content("~/images/default-image.svg"))" class="card-img-top" style="max-height: 150px; object-fit: contain;" alt="No Image Available">
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@vehicle.Make @vehicle.Model</h5>
                    <p class="card-text">@vehicle.CategoryName</p>
                    <p class="card-text">£@vehicle.Price.ToString("#,##0").Replace(",", ".")</p>
                    <div class="d-flex justify-content-between mt-auto">
                         @if (User?.Identity?.IsAuthenticated == true && !vehicle.IsOwner && !vehicle.IsSaved)
                        {

                            <form asp-controller="Vehicle" asp-action="Save" method="post" class="w-50">
                                <input type="hidden" name="id" value="@vehicle.Id" />
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-heart"></i> Favorites
                                </button>
                            </form>
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-info me-2 w-50">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                        }
                        else
                        { 
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-info w-100">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                         }  
                    </div>
                </div>
            </div>
        </div>
    }
</div>
