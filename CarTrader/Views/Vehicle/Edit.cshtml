@using CarTrader.Data.Enums
@model EditViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h1>Edit Vehicle</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mileage" class="form-label"></label>
        <input asp-for="Mileage" class="form-control" />
        <span asp-validation-for="Mileage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EngineSize" class="form-label"></label>
        <input asp-for="EngineSize" class="form-control" />
        <span asp-validation-for="EngineSize" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="mb-3 col-md-3">
            <label asp-for="Doors" class="form-label">Doors</label>
            <select asp-for="Doors" class="form-select" asp-items="Html.GetEnumSelectList<DoorCount>()"></select>
            <span asp-validation-for="Doors" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="FuelType" class="form-label">Fuel Type</label>
            <select asp-for="FuelType" class="form-select" asp-items="Html.GetEnumSelectList<FuelType>()"></select>
            <span asp-validation-for="FuelType" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="TransmissionType" class="form-label">Transmission</label>
            <select asp-for="TransmissionType" class="form-select" asp-items="Html.GetEnumSelectList<TransmissionType>()"></select>
            <span asp-validation-for="TransmissionType" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="Condition" class="form-label">Condition</label>
            <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<VehicleCondition>()"></select>
            <span asp-validation-for="Condition" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        @if (Model.Categories != null)
        {
            <select asp-for="CategoryId" class="form-select">
                <option value="">Select a category</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id ? "selected" : null)">@c.Name</option>
                }
            </select>
        }
        else
        {
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategorySelectList">
                <option value="">Select a category</option>
            </select>
        }
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
